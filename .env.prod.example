# ── PROD — referência do que configurar no Cloudflare ───────
#
# NÃO preencha valores aqui. Este arquivo existe só para
# lembrar QUAIS variáveis o ambiente precisa.
#
#   wrangler secret put DATABASE_URL --env prod
#   wrangler secret put SESSION_SECRET --env prod
#   ...
#
# As não-secretas vão em `env.prod.vars` no wrangler.jsonc (apps/web/wrangler.jsonc)

APP_ENV=prod
# ⚠️ Domínio de produção ainda NÃO fechado pelo Fundador — ver docs/architecture.md
# Anexo A item 2. `albora.com.br` aqui é suposição do template, não decisão tomada;
# confirmar antes de apontar DNS ou usar este valor de verdade.
APP_ROOT_DOMAIN=albora.com.br
MEDIA_DOMAIN=media.albora.com.br
R2_BUCKET=albora-media-prod
APP_URL=https://albora.com.br
APP_LINK_HOST=albora.com.br
NEXT_PUBLIC_APP_ENV=prod

# secretas — só via wrangler secret put
DATABASE_URL=
DATABASE_URL_DIRECT=
DATABASE_URL_AGGREGATOR=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
SESSION_SECRET=
RESEND_API_KEY=
RESEND_FROM=
DRIVE_OAUTH_CLIENT_ID=
DRIVE_OAUTH_CLIENT_SECRET=
DRIVE_OAUTH_STATE_SECRET=
DRIVE_TOKEN_ENC_KEY=
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# Sandbox vs. produção real é decisão do dono (não é credencial, mas move dinheiro
# de verdade quando "0") — deixar vazio aqui; default do código é sandbox seguro.
ASAAS_SANDBOX=
JOB_RUNNER_SECRET=
CRON_SECRET=
OPS_ALERT_WEBHOOK=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
