# ── HOMOL — referência do que configurar no Cloudflare ───────
#
# NÃO preencha valores aqui. Este arquivo existe só para
# lembrar QUAIS variáveis o ambiente precisa.
#
#   wrangler secret put DATABASE_URL --env homol
#   wrangler secret put SESSION_SECRET --env homol
#   ...
#
# As não-secretas vão em `env.homol.vars` no wrangler.jsonc (apps/web/wrangler.jsonc)
#
# NEXT_PUBLIC_* é caso à parte: o Next.js inlina essas variáveis no bundle do
# cliente em tempo de BUILD (`opennextjs-cloudflare build`, dentro de
# `pnpm cf:deploy:homol`), não em runtime do Worker — `wrangler secret put`/`vars`
# nunca chegam lá, porque o build já terminou antes de qualquer secret ser lido.
# Por isso NEXT_PUBLIC_* não é nem `vars` do wrangler.jsonc nem secret — é `env:`
# do passo "Deploy @albora/web (homol)" em `.github/workflows/deploy.yml`.

APP_ENV=homol
APP_ROOT_DOMAIN=homol.albora.com.br
MEDIA_DOMAIN=media-homol.albora.com.br
R2_BUCKET=albora-media-homol
APP_URL=https://homol.albora.com.br
APP_LINK_HOST=homol.albora.com.br

# build-time (Next.js — inlinada no bundle do cliente, ver comentário acima).
# NEXT_PUBLIC_SENTRY_DSN não é secret: um DSN de cliente Sentry é público por
# natureza (fica no bundle que qualquer convidado baixa) — só está aqui e não
# em wrangler.jsonc porque nada disso passa por `vars` de Worker.
NEXT_PUBLIC_APP_ENV=homol
NEXT_PUBLIC_SENTRY_DSN=

# secretas — só via wrangler secret put
DATABASE_URL=
DATABASE_URL_DIRECT=
DATABASE_URL_AGGREGATOR=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
SESSION_SECRET=
RESEND_API_KEY=
RESEND_FROM=
DRIVE_OAUTH_CLIENT_ID=
DRIVE_OAUTH_CLIENT_SECRET=
DRIVE_OAUTH_STATE_SECRET=
DRIVE_TOKEN_ENC_KEY=
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_SANDBOX=1
JOB_RUNNER_SECRET=
CRON_SECRET=
OPS_ALERT_WEBHOOK=
SENTRY_DSN=
