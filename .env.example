# ─────────────────────────────────────────────────────────────
# Albora — template de ambiente
#
# Copie para .env e preencha. O .env é gitignored.
#
# ⚠️ Em homol e prod as chaves NÃO vivem aqui — vivem no
#    Cloudflare, via `wrangler secret put NOME --env homol`.
#    Este arquivo é para desenvolvimento local.
# ─────────────────────────────────────────────────────────────

# dev | homol | prod
APP_ENV=dev

# Domínio raiz. O slug do evento é subdomínio: <slug>.<APP_ROOT_DOMAIN>
APP_ROOT_DOMAIN=localhost:3000

# Domínio próprio da mídia. NUNCA a mesma origem da aplicação:
# "JPEG" que é HTML servido da origem do app é XSS armazenado
# com alcance de festa inteira (docs/security.md §4.3)
#
# Vazio nesta fase: a mídia sai do endpoint S3 do R2, que já é
# outra origem, por URL assinada de GET com validade curta.
# Este knob é a porta do caminho de produção (domínio próprio
# ou Worker) e ainda não assina nada.
#
# Ligado ou não, o boot confere e RECUSA SUBIR se o host da
# mídia for o da aplicação — ou um subdomínio de
# APP_ROOT_DOMAIN, porque cada evento é um <slug>.<raiz> e um
# "midia.<raiz>" colide com o slug de mesmo nome.
MEDIA_DOMAIN=

# ── Banco ────────────────────────────────────────────────────
# POOLED (com -pooler no host) — a aplicação usa esta.
# Roda em modo transação, e é por isso que SET LOCAL é
# obrigatório e SET é proibido (ADR 0002, task 003)
DATABASE_URL=

# DIRETA (sem -pooler) — só migrations e linha de comando
DATABASE_URL_DIRECT=

# SEGUNDA pool, papel albora_agregador (NOLOGIN BYPASSRLS, migration 0002) —
# nunca a mesma credencial de DATABASE_URL. É a única porta autorizada a
# cruzar vendor_id/event_id (comAgregacao): "meus eventos" do fornecedor
# (eventosDoFornecedor) e a resolução pública de /f/{slug}
# (marcaPublicaDoFornecedor). Sem esta var, apps/web/lib/db.ts#getAggregatorPool
# falha alto — nunca cai de volta em DATABASE_URL.
DATABASE_URL_AGGREGATOR=

# ── Storage ──────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=albora-spike

# ── Sessão do convidado ──────────────────────────────────────
# Assina o token opaco. Um por ambiente, nunca compartilhado.
# Gere com: openssl rand -base64 32
SESSION_SECRET=

# ── Billing Asaas (checkout / webhook) ───────────────────────
# Sem ASAAS_API_KEY em APP_ENV=dev → stub + POST /api/billing/simulate.
# ASAAS_SANDBOX=0 usa api.asaas.com; omitido ou outro valor = sandbox.
# ASAAS_WEBHOOK_TOKEN = header asaas-access-token (obrigatório fora do stub).
# ASAAS_API_KEY=
# ASAAS_SANDBOX=1
# ASAAS_WEBHOOK_TOKEN=

# ── E-mail (magic link do anfitrião, avisos de export) ───────
RESEND_API_KEY=
# Remetente verificado no Resend. Sem isto o aviso degrada; o download
# autenticado no painel continua.
# RESEND_FROM=Albora <noreply@seudominio.com>

# ── Classificador de imagem (spec 011) ───────────────────────
# heuristico (padrão de produção) | silencio | stub
# stub só para teste: CLASSIFICADOR_IMAGEM_STUB=limpo|suspeito|sem-resposta|erro
CLASSIFICADOR_IMAGEM_PROVEDOR=heuristico

# ── Google Drive (export pós-evento + retenção, spec drive-export) ───
# Sem estas 4 vars, as rotas de Drive falham com 503 (ConfigError) — lazy,
# só no primeiro uso da rota, nunca no boot. O runner de retenção
# (tools/jobs/retention.mjs) também degrada sem elas: faz o gate/purge do
# D365 normalmente, só não chama revoke no Google.
#
# Projeto Google Cloud, OAuth client (tipo "Web application"), escopo
# https://www.googleapis.com/auth/drive.file. Preencher depois que o
# mantenedor criar o projeto e rodar a verificação (spec §1.4/§10, risco 1).
# DRIVE_OAUTH_CLIENT_ID=
# DRIVE_OAUTH_CLIENT_SECRET=
#
# Assina o `state` do handshake OAuth — segredo PRÓPRIO, nunca o
# SESSION_SECRET do convidado (blast radius separado por design).
# Gere com: openssl rand -base64 32
# DRIVE_OAUTH_STATE_SECRET=
#
# Chave AES-256 do vault que sela o refresh token do Drive do casal — 32
# bytes em base64, segredo PRÓPRIO, nunca compartilhado com os de cima.
# Gere com: openssl rand -base64 32
# DRIVE_TOKEN_ENC_KEY=
#
# Opcional — POST recebe { evento, eventId, motivo, diasDeAtraso, em } quando
# o D365 pula a deleção (skip nunca é silencioso). Sem isto, degrada para
# console.error bem visível.
# OPS_ALERT_WEBHOOK=
