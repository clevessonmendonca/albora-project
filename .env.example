# ───────────────────────────────────────────────────────────────
# ALBORA — Environment Variables Template
# ───────────────────────────────────────────────────────────────
# 
# ⚠️ NUNCA commite valores reais de secrets!
# ⚠️ Copie este arquivo para .env.local e preencha com valores reais
# ⚠️ .env.local está no .gitignore e NUNCA deve ser commitado
#
# ───────────────────────────────────────────────────────────────

# ── APPLICATION ─────────────────────────────────────────────────
APP_ENV=dev                          # dev | homol | prod
APP_ROOT_DOMAIN=localhost:3000       # domínio principal (ex: albora.com.br)
MEDIA_DOMAIN=                        # domínio de mídia (ex: media.albora.com.br) — opcional
APP_URL=                             # URL pública completa (https://...) — self-fetch do job runner (drive-export)
APP_LINK_HOST=                       # host dos universal/app links (padrão albora.app se ausente)

# ── DATABASE (Neon PostgreSQL) ──────────────────────────────────
# Pooled connection (recomendado para serverless)
DATABASE_URL=postgresql://user:password@host-pooler.region.neon.tech/dbname?sslmode=require

# Direct connection (para migrations)
DATABASE_URL_DIRECT=postgresql://user:password@host.region.neon.tech/dbname?sslmode=require

# Pool BYPASSRLS do papel `comAgregacao` (dashboard fornecedor/observabilidade) —
# credencial dedicada, nunca a mesma de DATABASE_URL; sem ela, agregação cross-evento falha alto.
DATABASE_URL_AGGREGATOR=

# ── STORAGE (Cloudflare R2) ─────────────────────────────────────
R2_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=your_access_key_here
R2_SECRET_ACCESS_KEY=your_secret_key_here
R2_BUCKET=your_bucket_name_here

# ── AUTHENTICATION ──────────────────────────────────────────────
# Gerar novo secret: openssl rand -base64 32
SESSION_SECRET=your_session_secret_here_min_32_chars

# ── EMAIL (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=                          # opcional — padrão "Albora <noreply@albora.app>" se ausente

# ── GOOGLE DRIVE (export do casal — apps/web/lib/infrastructure/storage/drive) ──
# Três segredos isolados: comprometer um não expõe os outros.
DRIVE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
DRIVE_OAUTH_CLIENT_SECRET=your_client_secret_here
DRIVE_OAUTH_STATE_SECRET=your_state_secret_here_min_32_chars
# Base64 de 32 bytes (AES-256-GCM do vault de token): openssl rand -base64 32
DRIVE_TOKEN_ENC_KEY=

# ── PAGAMENTO (Asaas — apps/web/lib/billing) ────────────────────
# Sem ASAAS_API_KEY e fora de APP_ENV=dev, cobrança fica "unavailable" (nunca stub em prod).
ASAAS_API_KEY=
# Header asaas-access-token do webhook — sem ela, parseWebhook aceita sem checar origem.
ASAAS_WEBHOOK_TOKEN=
# Ausente ou != "0" = sandbox.asaas.com (padrão seguro). "0" = api.asaas.com (produção real).
ASAAS_SANDBOX=1

# ── JOBS / CRON (export para Drive, retenção D330/D365) ─────────
# Autoriza `Authorization: Bearer $JOB_RUNNER_SECRET` no consumer HTTP da fila de export.
JOB_RUNNER_SECRET=
# Autoriza o cron de retenção (`POST /api/ops/retencao`).
CRON_SECRET=
# Opcional — webhook de alerta quando o D365 pula por falta de cobertura de export.
OPS_ALERT_WEBHOOK=

# ── APP NATIVO (universal links / app links — task 017) ─────────
IOS_APP_TEAM_ID=
IOS_APP_BUNDLE_ID=app.albora.guest
ANDROID_APP_PACKAGE=app.albora.guest
ANDROID_APP_SHA256=

# ── MONITORING & OBSERVABILITY (Optional) ───────────────────────
# Sentry (servidor)
SENTRY_DSN=https://your_key@sentry.io/project_id
# Sentry (cliente — precisa do prefixo NEXT_PUBLIC_ pra chegar no browser)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=dev
# Upload de sourcemap no build (opcional — sem SENTRY_AUTH_TOKEN, upload é pulado)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Axiom (Logs & Metrics)
AXIOM_API_KEY=your_axiom_key_here
AXIOM_DATASET=albora-logs

# Betterstack (Uptime & Logs)
BETTERSTACK_API_KEY=your_betterstack_key_here

# ── ANALYTICS (Optional) ────────────────────────────────────────
# Plausible / PostHog / etc.
ANALYTICS_KEY=your_analytics_key_here

# ── CI/CD (GitHub Actions) ──────────────────────────────────────
# Esses devem ser configurados como GitHub Secrets, não aqui
# - HOMOL_DATABASE_URL
# - PROD_DATABASE_URL
# - HOMOL_R2_ACCESS_KEY_ID / PROD_R2_ACCESS_KEY_ID (+ SECRET)
# - RESEND_API_KEY (homol/prod)
# - ASAAS_API_KEY / ASAAS_WEBHOOK_TOKEN (homol/prod)

# ── DEVELOPMENT ONLY ────────────────────────────────────────────
# Log level (debug | info | warn | error)
LOG_LEVEL=info

# Skip env validation (para builds de CI)
SKIP_ENV_VALIDATION=false

# ───────────────────────────────────────────────────────────────
# SECURITY CHECKLIST
# ───────────────────────────────────────────────────────────────
# 
# ✅ .env.local está no .gitignore?
# ✅ Secrets reais NUNCA commitados no Git?
# ✅ Secrets diferentes para dev/staging/prod?
# ✅ Rotacionar secrets a cada 90 dias (mínimo)?
# ✅ Secrets mascarados em logs?
# ✅ GitHub Secrets configurados para CI/CD?
# 
# ───────────────────────────────────────────────────────────────
