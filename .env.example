# ───────────────────────────────────────────────────────────────
# ALBORA — Environment Variables Template
# ───────────────────────────────────────────────────────────────
# 
# ⚠️ NUNCA commite valores reais de secrets!
# ⚠️ Copie este arquivo para .env.local e preencha com valores reais
# ⚠️ .env.local está no .gitignore e NUNCA deve ser commitado
#
# ───────────────────────────────────────────────────────────────

# ── APPLICATION ─────────────────────────────────────────────────
APP_ENV=dev                          # dev | staging | production
APP_ROOT_DOMAIN=localhost:3000       # domínio principal (ex: albora.app)
MEDIA_DOMAIN=                        # domínio de mídia (ex: media.albora.app) — opcional

# ── DATABASE (Neon PostgreSQL) ──────────────────────────────────
# Pooled connection (recomendado para serverless)
DATABASE_URL=postgresql://user:password@host-pooler.region.neon.tech/dbname?sslmode=require

# Direct connection (para migrations)
DATABASE_URL_DIRECT=postgresql://user:password@host.region.neon.tech/dbname?sslmode=require

# ── STORAGE (Cloudflare R2) ─────────────────────────────────────
R2_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=your_access_key_here
R2_SECRET_ACCESS_KEY=your_secret_key_here
R2_BUCKET=your_bucket_name_here

# ── AUTHENTICATION ──────────────────────────────────────────────
# Gerar novo secret: openssl rand -base64 32
SESSION_SECRET=your_session_secret_here_min_32_chars

# ── EMAIL (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=re_your_api_key_here

# ── GOOGLE DRIVE (Admin Integration) ────────────────────────────
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=https://your-domain.app/api/drive/callback

# ── MONITORING & OBSERVABILITY (Optional) ───────────────────────
# Sentry
SENTRY_DSN=https://your_key@sentry.io/project_id

# Axiom (Logs & Metrics)
AXIOM_API_KEY=your_axiom_key_here
AXIOM_DATASET=albora-logs

# Betterstack (Uptime & Logs)
BETTERSTACK_API_KEY=your_betterstack_key_here

# ── ANALYTICS (Optional) ────────────────────────────────────────
# Plausible / PostHog / etc.
ANALYTICS_KEY=your_analytics_key_here

# ── CI/CD (GitHub Actions) ──────────────────────────────────────
# Esses devem ser configurados como GitHub Secrets, não aqui
# - STAGING_DATABASE_URL
# - PROD_DATABASE_URL
# - STAGING_R2_ACCESS_KEY
# - PROD_R2_ACCESS_KEY
# - RESEND_API_KEY (staging/prod)

# ── DEVELOPMENT ONLY ────────────────────────────────────────────
# Log level (debug | info | warn | error)
LOG_LEVEL=info

# Skip env validation (para builds de CI)
SKIP_ENV_VALIDATION=false

# ───────────────────────────────────────────────────────────────
# SECURITY CHECKLIST
# ───────────────────────────────────────────────────────────────
# 
# ✅ .env.local está no .gitignore?
# ✅ Secrets reais NUNCA commitados no Git?
# ✅ Secrets diferentes para dev/staging/prod?
# ✅ Rotacionar secrets a cada 90 dias (mínimo)?
# ✅ Secrets mascarados em logs?
# ✅ GitHub Secrets configurados para CI/CD?
# 
# ───────────────────────────────────────────────────────────────
