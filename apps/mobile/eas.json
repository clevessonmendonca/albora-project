{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://SUBSTITUA.api.albora.app"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {}
  },
  "submit": {
    "production": {}
  }
}
