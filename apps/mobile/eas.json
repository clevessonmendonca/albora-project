{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://SUBSTITUA.api.albora.app"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://SUBSTITUA.api.albora.app"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://SUBSTITUA.api.albora.app",
        "EXPO_PUBLIC_APP_LINK_HOST": "albora.app"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "SUBSTITUA@email.com",
        "ascAppId": "SUBSTITUA",
        "appleTeamId": "SUBSTITUA_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./store/google-service-account.json",
        "track": "internal"
      }
    }
  }
}
