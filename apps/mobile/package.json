{
  "name": "@albora/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "fontes": "node scripts/copiar-fontes.mjs",
    "icones": "node scripts/gerar-icones.mjs",
    "feature-graphic": "node scripts/gerar-feature-graphic.mjs",
    "prestart": "node scripts/copiar-fontes.mjs",
    "eas-build-pre-install": "node scripts/copiar-fontes.mjs && node scripts/gerar-icones.mjs",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "build": "echo 'EAS Build — pnpm --filter @albora/mobile exec eas build'"
  },
  "dependencies": {
    "@albora/core": "workspace:*",
    "@albora/packs": "workspace:*",
    "@albora/tokens": "workspace:*",
    "@albora/ui-native": "workspace:*",
    "@react-native-community/netinfo": "11.4.1",
    "@shopify/react-native-skia": "1.11.11",
    "expo": "~53.0.22",
    "expo-av": "^16.0.8",
    "expo-background-fetch": "~13.1.6",
    "expo-camera": "~16.1.11",
    "expo-constants": "~17.1.7",
    "expo-crypto": "~14.1.5",
    "expo-dev-client": "~5.0.20",
    "expo-file-system": "~18.1.11",
    "expo-image-manipulator": "~13.1.7",
    "expo-image-picker": "~16.1.4",
    "expo-linking": "~7.1.7",
    "expo-router": "~5.1.4",
    "expo-secure-store": "~14.2.3",
    "expo-sharing": "^57.0.14",
    "expo-status-bar": "~2.2.3",
    "expo-task-manager": "~13.1.6",
    "jpeg-js": "^0.4.4",
    "nativewind": "^4.1.23",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@types/jpeg-js": "^0.3.7",
    "@types/react": "^19.1.0",
    "sharp": "^0.34.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
