{
  "name": "@albora/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "sw:build": "node scripts/construir-sw.mjs",
    "predev": "pnpm sw:build && pnpm fontes",
    "dev": "next dev",
    "prebuild": "pnpm sw:build --producao && pnpm fontes",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "fontes": "node scripts/copiar-fontes.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && wrangler dev",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "lighthouse": "lhci autorun",
    "lighthouse:collect": "lhci collect",
    "lighthouse:assert": "lhci assert",
    "lighthouse:upload": "lhci upload"
  },
  "dependencies": {
    "@albora/core": "workspace:*",
    "@albora/db": "workspace:*",
    "@albora/packs": "workspace:*",
    "@albora/tokens": "workspace:*",
    "@albora/ui-web": "workspace:*",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@opennextjs/cloudflare": "^1.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "aws4fetch": "^1.0.20",
    "next": "^15.5.4",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "web-vitals": "^6.2.1",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260426.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jpeg-js": "^0.3.7",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.28.2",
    "jpeg-js": "^0.4.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "wrangler": "^4.20.0"
  }
}
