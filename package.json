{
  "name": "albora",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "dev": "pnpm --filter @albora/web dev",
    "build": "pnpm -r --filter=!@albora/mobile build",
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "test": "vitest run",
    "guards": "node tools/guards/todos.mjs",
    "prepare": "husky",
    "test:isolamento": "vitest run --config vitest.isolamento.config.ts",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down -v",
    "db:semear": "node tools/db/semear-dev.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.17.0",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "pg": "^8.23.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.0.0"
  }
}
