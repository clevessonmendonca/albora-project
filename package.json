{
  "name": "albora",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "dev": "pnpm --filter @albora/web dev",
    "build": "pnpm -r --filter=!@albora/mobile build",
    "typecheck": "tsc --build && tsc -p apps/web --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "guards": "node tools/guards/todos.mjs",
    "prepare": "husky",
    "test:isolamento": "vitest run --config vitest.isolamento.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:full": "E2E_FULL=1 playwright test",
    "bundle:budget": "node tools/bundle/orcamento-convidado.mjs",
    "bundle:budget:report": "node tools/bundle/orcamento-convidado.mjs --report-only",
    "carga": "node tools/carga/executar.mjs",
    "carga:smoke": "CARGA_TOTAL=6 CARGA_DURACAO_MIN=1 CARGA_CONVIDADOS=3 CARGA_PICOS=1 node tools/carga/executar.mjs",
    "carga:limpar": "node tools/carga/limpar.mjs",
    "deploy:smoke": "node tools/deploy/smoke.mjs",
    "drive-export": "node tools/jobs/drive-export.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down -v",
    "db:semear": "node tools/db/semear-dev.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "pg": "^8.23.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.0.0"
  }
}
